# ---------------------------------------------------------------------------
# Copy to .env.local for development, and set the same keys in Vercel →
# Project → Settings → Environment Variables for production.
# ---------------------------------------------------------------------------

# Canonical site URL. Drives metadataBase, canonical tag, sitemap and OG URLs.
# Set this to the real domain once you have one.
NEXT_PUBLIC_SITE_URL="https://zahoorahmed.de"
# Google Search Console → Settings → Ownership verification → HTML tag. Paste only
# the content="…" value. Not needed if you verify the domain via DNS instead.
GOOGLE_SITE_VERIFICATION=""
# Bing Webmaster Tools → Add a site → verify with the HTML meta tag. Paste only the
# content="…" value of <meta name="msvalidate.01" …>. The same token also powers
# /BingSiteAuth.xml, so either verification method works. Bing feeds Copilot and
# ChatGPT search, so this matters for AI visibility too.
BING_SITE_VERIFICATION=""

# Resend API key — https://resend.com/api-keys
# Without it the contact form still renders and validates, but tells visitors
# to email you directly instead of silently failing.
RESEND_API_KEY=""

# Where contact-form submissions are delivered. Defaults to the address in
# content/site.ts if unset.
CONTACT_TO_EMAIL="zahoor_ahmed143@hotmail.com"

# Sender address. Resend only allows a custom sender on a DOMAIN YOU HAVE
# VERIFIED with them. Until you own and verify a domain, leave this unset —
# the app falls back to onboarding@resend.dev, which Resend delivers only to
# the inbox of the Resend account owner (that's you, so the form works).
# Must be on a domain verified with Resend.
CONTACT_FROM_EMAIL="Zahoor Ahmed <zahoor@zahoorahmed.de>"

# ---------------------------------------------------------------------------
# Admin panel (résumé, cover letter, outreach templates, blog)
# ---------------------------------------------------------------------------

# Postgres connection string. Without it the admin still runs locally and writes
# to .data/, but on Vercel the filesystem is read-only so nothing persists —
# set this before relying on the admin in production.
# On Vercel use Supabase's POOLER host, not the direct db.<ref>.supabase.co one:
# the direct host is IPv6-only and Vercel functions cannot reach it (ENOTFOUND).
#   postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
# Apply the schema once:  psql "$DATABASE_URL" -f lib/db/schema.sql
DATABASE_URL=""

# Password for /admin.
ADMIN_PASSWORD=""

# Signing key for the admin session cookie. At least 32 characters.
# Generate one with:  openssl rand -hex 32
ADMIN_SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Campaign email sending
# ---------------------------------------------------------------------------

# Two transports are supported. SMTP is used when EMAIL_USER and EMAIL_PASS are
# both set; otherwise Resend is used if RESEND_API_KEY is set.
#
#   SMTP  — sends from your own mailbox. Good for one-off personal email.
#           Outlook/Hotmail defaults are below (STARTTLS on 587; Microsoft does
#           not accept implicit TLS on 465). Note that Microsoft has been
#           disabling basic authentication on personal Outlook/Hotmail accounts,
#           so this may simply refuse to log in — use the "Test connection"
#           button in /admin/email to find out before relying on it.
#
#   Resend — needs a domain you have verified with them, and is the right choice
#           for campaigns: proper SPF/DKIM, and it will not put your personal
#           mailbox at risk of being throttled or suspended for bulk sending.
#
# Either way, Reply-To is set to CONTACT_TO_EMAIL, so replies land in your
# personal inbox regardless of which transport carried the message.
EMAIL_HOST="smtp-mail.outlook.com"
EMAIL_PORT="587"
EMAIL_SECURE="false"
EMAIL_USER=""
EMAIL_PASS=""

# Optional: blind-copy yourself on every campaign send, for your own records.
CAMPAIGN_BCC=""

# Emails per worker invocation. Keep it small enough that a batch finishes
# inside the serverless function timeout. Default 25.
EMAIL_JOB_BATCH_SIZE="25"

# Shared secret for /api/cron/campaigns. Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`. Generate with: openssl rand -hex 32
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Sending from Hotmail / Outlook (OAuth2)
# ---------------------------------------------------------------------------
# Microsoft no longer accepts passwords for SMTP on personal accounts, so the
# admin connects the mailbox once via "Connect Hotmail" (Send an email page).
# That needs a free app registration:
#   https://portal.azure.com → App registrations → New registration
#     Supported account types: Personal Microsoft accounts (or any org + personal)
#     Redirect URIs (Web) — add BOTH public hosts, since cookies are per host:
#       https://zahoorahmed.de/api/admin/microsoft/callback
#       https://www.zahoorahmed.de/api/admin/microsoft/callback
#     (for local dev also add http://localhost:3210/api/admin/microsoft/callback)
#   Certificates & secrets → New client secret → copy the VALUE (not the ID)
# Then set both here and in Vercel. Tokens are stored encrypted in Postgres.
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
# Only if the callback must differ from <site url>/api/admin/microsoft/callback.
MS_REDIRECT_URI=""
